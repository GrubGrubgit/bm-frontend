<?xml version="1.0" encoding="utf-8"?>
<widget id="dev.bmweb.frontend" version="0.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BM-Web</name>
  <description>Blaster Master native web port (WebGL video, live NES APU audio, touch/keyboard/gamepad). You supply your own ROM in-page.</description>
  <author email="dev@bmweb.local" href="https://bmweb.local">
    BM-Web
  </author>
  <content src="index.html" />
  <preference name="Fullscreen" value="true" />
  <preference name="Orientation" value="default" />
  <preference name="BackgroundColor" value="#ff111111" />
  <preference name="AndroidXEnabled" value="true" />
  <platform name="android">
    <preference name="android-minSdkVersion" value="29" />
    <preference name="android-targetSdkVersion" value="36" />
    <icon density='ldpi' src='res/android/ldpi.png' />
    <icon density='mdpi' src='res/android/mdpi.png' />
    <icon density='hdpi' src='res/android/hdpi.png' />
    <icon density='xhdpi' src='res/android/xhdpi.png' />
    <icon density='xxhdpi' src='res/android/xxhdpi.png' />
    <icon density='xxxhdpi' src='res/android/xxxhdpi.png' />
    <icon density='ldpi' background='res/android/bg-ldpi.png' foreground='res/android/fg-ldpi.png' />
    <icon density='mdpi' background='res/android/bg-mdpi.png' foreground='res/android/fg-mdpi.png' />
    <icon density='hdpi' background='res/android/bg-hdpi.png' foreground='res/android/fg-hdpi.png' />
    <icon density='xhdpi' background='res/android/bg-xhdpi.png' foreground='res/android/fg-xhdpi.png' />
    <icon density='xxhdpi' background='res/android/bg-xxhdpi.png' foreground='res/android/fg-xxhdpi.png' />
    <icon density='xxxhdpi' background='res/android/bg-xxxhdpi.png' foreground='res/android/fg-xxxhdpi.png' />
  </platform>
</widget>
